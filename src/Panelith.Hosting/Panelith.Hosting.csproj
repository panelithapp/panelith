<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Panelith.Hosting</RootNamespace>
    <Description>Wires sensors, panels and themes together for the Panelith command line and desktop app.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The media session is a Windows Runtime API. The projection assemblies are
    referenced directly so this library can stay on net10.0 and still build on
    Linux, where those files are left out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.NET.Ref" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Platform/PlatformSensors.cs" />
    <!--
      The reference is for the compiler. The content copy is what a normal build
      places next to the app. Publish already picks up the reference, so the
      content copy stays out of the published folder.
    -->
    <Reference Include="WinRT.Runtime">
      <HintPath>$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net8.0\WinRT.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net8.0\Microsoft.Windows.SDK.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Content Include="$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net8.0\WinRT.Runtime.dll" Link="WinRT.Runtime.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net8.0\Microsoft.Windows.SDK.NET.dll" Link="Microsoft.Windows.SDK.NET.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Platform/PlatformSensors.Windows.cs" />
    <Compile Remove="Platform/MediaSessionSensorSource.cs" />
    <Compile Remove="Platform/AudioDeviceSensorSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Panelith.Engine/Panelith.Engine.csproj" />
    <ProjectReference Include="../Panelith.Devices/Panelith.Devices.csproj" />
    <ProjectReference Include="../Panelith.Rendering/Panelith.Rendering.csproj" />
    <ProjectReference Include="../Panelith.Monitoring/Panelith.Monitoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Panelith.Hosting.Tests" />
  </ItemGroup>

</Project>
